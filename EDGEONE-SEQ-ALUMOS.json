{
  "FormatVersion": "1.0",
  "Rules": [
    {
      "RuleName": "网站加速-seq.alumos.cn",
      "Branches": [
        {
          "Condition": "${http.request.host} in ['seq.alumos.cn']",
          "Actions": [
            {
              "Name": "Cache",
              "CacheParameters": {
                "FollowOrigin": {
                  "Switch": "on",
                  "DefaultCache": "on",
                  "DefaultCacheStrategy": "on",
                  "DefaultCacheTime": 0
                }
              }
            },
            {
              "Name": "CacheKey",
              "CacheKeyParameters": {
                "QueryString": {
                  "Switch": "off",
                  "Values": []
                },
                "FullURLCache": "on",
                "IgnoreCase": "off"
              }
            }
          ],
          "SubRules": [
            {
              "Branches": [
                {
                  "Condition": "lower(${http.request.file_extension}) in ['js', 'mjs', 'css', 'svg', 'png', 'jpg', 'jpeg', 'gif', 'webp', 'ico', 'woff', 'woff2']",
                  "Actions": [
                    {
                      "Name": "MaxAge",
                      "MaxAgeParameters": {
                        "FollowOrigin": "off",
                        "CacheTime": 300
                      }
                    }
                  ]
                }
              ],
              "Description": []
            }
          ]
        }
      ],
      "Description": []
    }
  ]
}
